# Copy to .env.local for local development (never commit .env.local).
# In production, set the same keys in Netlify → Site configuration → Environment variables.

# ── App ───────────────────────────────────────────────────────────────
# http://localhost:3000 locally, https://<company-domain> in production
NEXT_PUBLIC_SITE_URL=

# Public business details shown on the website (top bar, footer, contact page)
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_COMPANY_EMAIL=

# ── Database: PostgreSQL on Neon (local option: Docker Postgres) ───────
# Pooled connection string (used by the app)
DATABASE_URL=
# Direct (non-pooled) connection string (used by Prisma migrations)
DIRECT_URL=

# ── Authentication: Better Auth ───────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same as NEXT_PUBLIC_SITE_URL for each environment
BETTER_AUTH_URL=

# ── Email: Resend (sending) ───────────────────────────────────────────
RESEND_API_KEY=
# onboarding@resend.dev until the domain is verified, then quotes@<company-domain>
EMAIL_FROM=
# Company inbox(es) that receive notifications (Zoho Mail)
EMAIL_COMPANY_INBOX=

# ── File storage: Cloudinary ──────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# uvm/dev locally and on previews, uvm/prod in production
CLOUDINARY_FOLDER=

# ── Bot protection: Cloudflare Turnstile ──────────────────────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics: Cloudflare Web Analytics (optional) ────────────────────
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# ── Internal ──────────────────────────────────────────────────────────
# "true" shows /styleguide on deploy previews (always on in development)
ENABLE_STYLEGUIDE=
