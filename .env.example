# Copy to .env.local for local development (never commit .env.local).
# In production, set the same keys in Netlify → Site configuration → Environment variables.

# ── App ───────────────────────────────────────────────────────────────
# http://localhost:3000 locally, https://<company-domain> in production
NEXT_PUBLIC_SITE_URL=

# Public business details shown on the website (top bar, footer, contact page)
NEXT_PUBLIC_COMPANY_NAME=
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_COMPANY_EMAIL=

# ── Email: Resend (sending) ───────────────────────────────────────────
# Without these, form emails are printed in the terminal during `npm run dev`.
# Setup steps: docs/FORMS-EMAIL-SETUP.md
RESEND_API_KEY=
# onboarding@resend.dev until the domain is verified, then quotes@<company-domain>
EMAIL_FROM=
# Company inbox(es) that receive form emails, comma-separated (Zoho Mail)
EMAIL_COMPANY_INBOX=

# ── File storage: Cloudinary (CVs, licences, incident photos) ─────────
# Required in production for the Drive With Us form. Locally, files are skipped when empty.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# uvm/dev locally and on previews, uvm/prod in production
CLOUDINARY_FOLDER=

# ── Bot protection: Cloudflare Turnstile ──────────────────────────────
# Optional locally (the check is skipped when empty). Cloudflare's test keys:
# site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Internal ──────────────────────────────────────────────────────────
# "true" shows /styleguide on deploy previews (always on in development)
ENABLE_STYLEGUIDE=

# ── Social profiles (optional; icons are hidden when empty) ───────────
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_TIKTOK=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
